---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Admin · SRI SUBHAM</title>
  </head>
  <body class="admin">
    <div class="admin-bar">
      <div class="wrap">
        <nav>
          <a href="/admin" aria-current={path === '/admin' ? 'page' : undefined}>Overview</a>
          <a href="/admin/categories" aria-current={path.startsWith('/admin/categories') ? 'page' : undefined}>Categories</a>
          <a href="/admin/products" aria-current={path.startsWith('/admin/products') ? 'page' : undefined}>Products</a>
        </nav>
        <div>
          <a href="/">View site</a>
          <form class="inline-form" method="post" action="/admin/logout" style="display:inline">
            <button class="secondary" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
    <main>
      <div class="wrap">
        <h1>{title}</h1>
        <slot />
      </div>
    </main>
  </body>
</html>

---
import Base from '../../layouts/Base.astro';
import { getProductBySlug, listProducts } from '../../lib/db';
import { withBase } from '../../lib/url';

export const prerender = true;

export function getStaticPaths() {
  return listProducts().map((product) => ({ params: { slug: product.slug } }));
}

const slug = Astro.params.slug ?? '';
const product = getProductBySlug(slug);
const initial = product?.name.trim().charAt(0).toUpperCase() ?? '';
---

<Base title={product?.name ?? 'Product not found'}>
  {
    product ? (
      <article class="product-detail">
        <div class="card-media">
          {product.image_path ? (
            <img src={withBase(product.image_path)} alt={product.name} />
          ) : (
            <span class="placeholder">{initial}</span>
          )}
        </div>
        <div>
          <p class="eyebrow">
            <a href={withBase(`/products?category=${product.category_slug}`)}>{product.category_name}</a>
          </p>
          <h1>{product.name}</h1>
          {product.description ? <p>{product.description}</p> : <p class="empty">No description yet.</p>}
          <p class="empty">Available in our shops. This page does not sell online.</p>
          <p>
            <a href={withBase('/products')}>Back to products</a>
          </p>
        </div>
      </article>
    ) : (
      <>
        <h1>Product not found</h1>
        <p>
          <a href={withBase('/products')}>Back to products</a>
        </p>
      </>
    )
  }
</Base>

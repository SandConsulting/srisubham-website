---
import Admin from '../../layouts/Admin.astro';
import {
  categoryProductCount,
  createCategory,
  deleteCategory,
  listCategories,
  moveCategory,
  renameCategory,
} from '../../lib/db';

let error = Astro.url.searchParams.get('error') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = Number(form.get('id'));
  try {
    if (action === 'create') createCategory(String(form.get('name') ?? ''));
    else if (action === 'rename') renameCategory(id, String(form.get('name') ?? ''));
    else if (action === 'up') moveCategory(id, 'up');
    else if (action === 'down') moveCategory(id, 'down');
    else if (action === 'delete') deleteCategory(id);
    return Astro.redirect('/admin/categories');
  } catch (err) {
    error = err instanceof Error ? err.message : 'Could not update categories.';
  }
}

const categories = listCategories().map((category) => ({
  ...category,
  products: categoryProductCount(category.id),
}));
---

<Admin title="Categories">
  {error && <p class="error">{error}</p>}
  <form class="inline-form" method="post" style="margin-bottom: 1.25rem">
    <input type="hidden" name="action" value="create" />
    <label>
      New category
      <input name="name" required placeholder="Category name" />
    </label>
    <button type="submit">Add</button>
  </form>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Products</th>
          <th>Order</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          categories.map((category, index) => (
            <tr>
              <td>
                <form class="inline-form" method="post">
                  <input type="hidden" name="action" value="rename" />
                  <input type="hidden" name="id" value={category.id} />
                  <input name="name" value={category.name} required />
                  <button class="secondary" type="submit">Rename</button>
                </form>
              </td>
              <td>{category.products}</td>
              <td>
                <form class="inline-form" method="post">
                  <input type="hidden" name="id" value={category.id} />
                  <button class="secondary" name="action" value="up" disabled={index === 0}>
                    Up
                  </button>
                  <button
                    class="secondary"
                    name="action" value="down"
                    disabled={index === categories.length - 1}
                  >
                    Down
                  </button>
                </form>
              </td>
              <td>
                <form method="post" onsubmit="return confirm('Delete this category?')">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={category.id} />
                  <button class="danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Admin>
